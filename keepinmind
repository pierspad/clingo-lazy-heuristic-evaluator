

===================================================================
FASE 1: COMPILAZIONE PULITA (Da fare dentro srun UNA TANTUM)
===================================================================



# 1. Entra nel nodo di calcolo:
   srun --partition=kr --pty bash

# 2. Carica i moduli e pialla le vecchie build corrotte:
   module load cmake/3.31.11-gcc-12.5.0-6sfht6u ninja
   rm -rf ~/clingo-lazy-heuristics/clingo-native/build
   rm -rf ~/clingo-lazy-heuristics/clingo-prolog/build

# 3. Compila NATIVO:
   cd ~/clingo-lazy-heuristics/clingo-native
   mkdir -p build && cd build
   cmake .. -G Ninja -DCMAKE_BUILD_TYPE=Release
   ninja

# 4. Compila PROLOG (CON FLAG SWIPL ATTIVO!):
   cd ~/clingo-lazy-heuristics/clingo-prolog
   mkdir -p build && cd build
   cmake .. -G Ninja -DCMAKE_BUILD_TYPE=Release -DCLINGO_USE_SWIPL=ON
   ninja

# 5. Torna al nodo di login:
   exit







