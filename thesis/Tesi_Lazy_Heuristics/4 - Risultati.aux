\@writefile{toc}{\contentsline {section}{\numberline {4.7}The Price of Laziness: Per-Decision Cost}{36}{section.4.7}\protected@file@percent }
\newlabel{sec:per-decision-cost}{{4.7}{36}{The Price of Laziness: Per-Decision Cost}{section.4.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.7}{\ignorespaces Propagator instrumentation on representative solved runs. \emph  {decide calls} and \emph  {cand./decide} are taken from the Prolog backend, which counts every candidate the \texttt  {heuristic/4} query returns; \emph  {ms/decide} is the average time of one consultation, reported by both backends; \emph  {sync} is the cumulative cost of mirroring the solver trail into the Prolog database; \emph  {prop.\ share} is the fraction of the Prolog run spent inside the propagator (query plus synchronization). The native backend's own synchronization is not shown because it never exceeds $0.3$ seconds in the whole campaign.}}{36}{table.4.7}\protected@file@percent }
\newlabel{tab:per-decision}{{4.7}{36}{Propagator instrumentation on representative solved runs. \emph {decide calls} and \emph {cand./decide} are taken from the Prolog backend, which counts every candidate the \texttt {heuristic/4} query returns; \emph {ms/decide} is the average time of one consultation, reported by both backends; \emph {sync} is the cumulative cost of mirroring the solver trail into the Prolog database; \emph {prop.\ share} is the fraction of the Prolog run spent inside the propagator (query plus synchronization). The native backend's own synchronization is not shown because it never exceeds $0.3$ seconds in the whole campaign}{table.4.7}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces BSP, Prolog backend: decide calls and per-decision query cost. The \texttt  {lc} curve pairs tens of thousands of calls with a low unit cost; \texttt  {la} the opposite.}}{37}{figure.4.6}\protected@file@percent }
\newlabel{fig:bsp-instrumentation}{{4.6}{37}{BSP, Prolog backend: decide calls and per-decision query cost. The \texttt {lc} curve pairs tens of thousands of calls with a low unit cost; \texttt {la} the opposite}{figure.4.6}{}}
