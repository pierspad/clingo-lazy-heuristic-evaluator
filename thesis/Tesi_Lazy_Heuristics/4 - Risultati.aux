\@writefile{lot}{\contentsline {table}{\numberline {4.8}{\ignorespaces PUP frontier, C++ backend, 600\,s / 30\,GB per run: largest \texttt  {double-$N$} solved and its cost. \texttt  {ga} and \texttt  {la} solve the whole tested range and are reported at $N=200$; the other three fail inside the range, and are reported at the largest size they solve. Unlike the BSP table, the separations here are between programs of different size: \texttt  {ga} grounds twice the memory of \texttt  {la} at every common size, a factor two orders of magnitude above the few-percent resolution established in Section~\ref {sec:time-reliability}.}}{36}{table.4.8}\protected@file@percent }
\newlabel{tab:pup-frontier}{{4.8}{36}{PUP frontier, C++ backend, 600\,s / 30\,GB per run: largest \texttt {double-$N$} solved and its cost. \texttt {ga} and \texttt {la} solve the whole tested range and are reported at $N=200$; the other three fail inside the range, and are reported at the largest size they solve. Unlike the BSP table, the separations here are between programs of different size: \texttt {ga} grounds twice the memory of \texttt {la} at every common size, a factor two orders of magnitude above the few-percent resolution established in Section~\ref {sec:time-reliability}}{table.4.8}{}}
\def\@LN@column{1}
