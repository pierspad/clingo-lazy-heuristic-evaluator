\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces BSP, C++ backend, exploratory comparison: solving time (left) and solver choices (right) with both Alpha simulations alongside the main variants. \texttt  {ga} is exact up to $n=50$, degrades from $n=51$ once its weights leave the representable range, needs $1.7$ million choices and $137$ seconds of solving at $n=60$, and times out from $n=70$; \texttt  {ga\_weak} stays in the baseline's band over the whole range and reaches $n=140$ on both backends, two sizes short of the baseline.}}{32}{figure.4.8}\protected@file@percent }
\newlabel{fig:gaweak}{{4.8}{32}{BSP, C++ backend, exploratory comparison: solving time (left) and solver choices (right) with both Alpha simulations alongside the main variants. \texttt {ga} is exact up to $n=50$, degrades from $n=51$ once its weights leave the representable range, needs $1.7$ million choices and $137$ seconds of solving at $n=60$, and times out from $n=70$; \texttt {ga\_weak} stays in the baseline's band over the whole range and reaches $n=140$ on both backends, two sizes short of the baseline}{figure.4.8}{}}
