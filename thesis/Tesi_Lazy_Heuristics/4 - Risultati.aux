\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces BSP: the four clingo variants and the heuristic-free clingo baseline against Alpha with and without its declarative heuristic. Left, wall time; right, peak RSS. The \texttt  {Alpha Qh} curve lies on the horizontal axis of both plots for the whole range; \texttt  {Alpha (no heur)} instead leaves it, and stops at $n=40$, earlier than any clingo variant.}}{39}{figure.4.15}\protected@file@percent }
\newlabel{fig:alpha-bsp}{{4.15}{39}{BSP: the four clingo variants and the heuristic-free clingo baseline against Alpha with and without its declarative heuristic. Left, wall time; right, peak RSS. The \texttt {Alpha Qh} curve lies on the horizontal axis of both plots for the whole range; \texttt {Alpha (no heur)} instead leaves it, and stops at $n=40$, earlier than any clingo variant}{figure.4.15}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces BSP, Alpha's own counters, plotted apart from every clingo measure because they are not commensurable with clasp's (Section~\ref {sec:alpha-setup}). Top row: with the heuristic, guesses stay equal to $n$ and backtracks at zero over the whole range, while the heuristic-free run spikes to some $67{,}000$ of each at $n=30$ and stops at $n=40$. Bottom row: the cost of the heuristic itself, which is a Prolog query in this variant --- $2.2$ seconds cumulative at $n=200$, at $1.9$ to $5.4$ milliseconds per query.}}{40}{figure.4.16}\protected@file@percent }
\newlabel{fig:alpha-internals}{{4.16}{40}{BSP, Alpha's own counters, plotted apart from every clingo measure because they are not commensurable with clasp's (Section~\ref {sec:alpha-setup}). Top row: with the heuristic, guesses stay equal to $n$ and backtracks at zero over the whole range, while the heuristic-free run spikes to some $67{,}000$ of each at $n=30$ and stops at $n=40$. Bottom row: the cost of the heuristic itself, which is a Prolog query in this variant --- $2.2$ seconds cumulative at $n=200$, at $1.9$ to $5.4$ milliseconds per query}{figure.4.16}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces PUP: the same comparison. \texttt  {Alpha (no heur)} does not appear because it solves no instance at all, not even \texttt  {double-20}. Here the clingo lazy variant stays within a small factor of Alpha in time and matches it in memory, while the ground simulation \texttt  {ga} is worse than Alpha on both axes.}}{41}{figure.4.17}\protected@file@percent }
\newlabel{fig:alpha-pup}{{4.17}{41}{PUP: the same comparison. \texttt {Alpha (no heur)} does not appear because it solves no instance at all, not even \texttt {double-20}. Here the clingo lazy variant stays within a small factor of Alpha in time and matches it in memory, while the ground simulation \texttt {ga} is worse than Alpha on both axes}{figure.4.17}{}}
