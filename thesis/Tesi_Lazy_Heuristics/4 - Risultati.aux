\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces BSP internal search counters for Alpha across instance sizes. Top row: with heuristics (\texttt  {alpha\_qh}), guesses remain equal to $n$ with zero backtracks; without heuristics (\texttt  {alpha\_noheur}), search explodes past $n=20$ and the curve stops at $n=40$, the last size it solves. Bottom row: cumulative Prolog query evaluation time for \texttt  {alpha\_qh} ($2.2$\,s total at $n=200$, averaging $1.0$ to $5.4$\,ms per consultation).}}{47}{figure.4.18}\protected@file@percent }
