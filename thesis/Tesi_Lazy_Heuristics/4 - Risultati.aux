\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces BSP, native backend: total clingo time. One run per point; a curve ends where its variant stops solving within the limits. Above $n \approx 120$ the three same-encoding curves (\texttt  {gc\_noheur}, \texttt  {la}, \texttt  {lc}) cross each other repeatedly: they ground identical programs, and the crossings are the node-to-node spread of Section~\ref {sec:node-variance}, not a difference between variants. Figure~\ref {fig:bsp-solving} isolates the component that does separate them.}}{31}{figure.4.2}\protected@file@percent }
\newlabel{fig:bsp-total}{{4.2}{31}{BSP, native backend: total clingo time. One run per point; a curve ends where its variant stops solving within the limits. Above $n \approx 120$ the three same-encoding curves (\texttt {gc\_noheur}, \texttt {la}, \texttt {lc}) cross each other repeatedly: they ground identical programs, and the crossings are the node-to-node spread of Section~\ref {sec:node-variance}, not a difference between variants. Figure~\ref {fig:bsp-solving} isolates the component that does separate them}{figure.4.2}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces BSP, native backend: solving time only. \texttt  {la} is indistinguishable from zero at every size; \texttt  {ga} leaves the chart after $n=60$.}}{32}{figure.4.3}\protected@file@percent }
\newlabel{fig:bsp-solving}{{4.3}{32}{BSP, native backend: solving time only. \texttt {la} is indistinguishable from zero at every size; \texttt {ga} leaves the chart after $n=60$}{figure.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces BSP at $n=120$, native backend, under the 600\,s / 30\,GB limits. \emph  {T} marks a timeout; the parenthesized solving value for \texttt  {ga} is a lower bound (total minus grounding at the moment it was killed), and its choices/conflicts are the counts reached before the kill. \texttt  {gc\_noheur}, \texttt  {la} and \texttt  {lc} ground programs of the same size (about $52.76$ million rules), and \texttt  {gc}, \texttt  {ga} and \texttt  {ga\_weak} programs of another common size (about $54.5$ million): differences in the grounding column within each group are node spread, not variant cost, and only the solving column separates same-encoding variants reliably --- and even there, a gap of a few seconds between \texttt  {gc\_noheur}, \texttt  {ga\_weak} and \texttt  {lc} carries no signal. Choices and conflicts are exact. \texttt  {la\_aux} is discussed in Section~\ref {sec:aux-form}.}}{32}{table.4.5}\protected@file@percent }
\newlabel{tab:bsp-n120}{{4.5}{32}{BSP at $n=120$, native backend, under the 600\,s / 30\,GB limits. \emph {T} marks a timeout; the parenthesized solving value for \texttt {ga} is a lower bound (total minus grounding at the moment it was killed), and its choices/conflicts are the counts reached before the kill. \texttt {gc\_noheur}, \texttt {la} and \texttt {lc} ground programs of the same size (about $52.76$ million rules), and \texttt {gc}, \texttt {ga} and \texttt {ga\_weak} programs of another common size (about $54.5$ million): differences in the grounding column within each group are node spread, not variant cost, and only the solving column separates same-encoding variants reliably --- and even there, a gap of a few seconds between \texttt {gc\_noheur}, \texttt {ga\_weak} and \texttt {lc} carries no signal. Choices and conflicts are exact. \texttt {la\_aux} is discussed in Section~\ref {sec:aux-form}}{table.4.5}{}}
