\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces BSP, native backend: total clingo time. One run per point; a curve ends where its variant stops solving within the limits. The three same-encoding curves (\texttt  {gc\_noheur}, \texttt  {la}, \texttt  {lc}) share a grounding component that agrees to a few percent at every size, so the vertical distance between them is their solving time: \texttt  {la} runs below the other two throughout, and \texttt  {gc\_noheur} and \texttt  {lc} lie on top of each other. Figure~\ref {fig:bsp-solving} isolates that component.}}{26}{figure.4.2}\protected@file@percent }
\newlabel{fig:bsp-total}{{4.2}{26}{BSP, native backend: total clingo time. One run per point; a curve ends where its variant stops solving within the limits. The three same-encoding curves (\texttt {gc\_noheur}, \texttt {la}, \texttt {lc}) share a grounding component that agrees to a few percent at every size, so the vertical distance between them is their solving time: \texttt {la} runs below the other two throughout, and \texttt {gc\_noheur} and \texttt {lc} lie on top of each other. Figure~\ref {fig:bsp-solving} isolates that component}{figure.4.2}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces BSP, native backend: solving time only. \texttt  {la} is indistinguishable from zero at every size; \texttt  {ga} leaves the chart after $n=60$.}}{27}{figure.4.3}\protected@file@percent }
\newlabel{fig:bsp-solving}{{4.3}{27}{BSP, native backend: solving time only. \texttt {la} is indistinguishable from zero at every size; \texttt {ga} leaves the chart after $n=60$}{figure.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces BSP at $n=120$, native backend, under the 600\,s / 30\,GB limits. \emph  {T} marks a timeout; the parenthesized solving value for \texttt  {ga} is a lower bound (total minus grounding at the moment it was killed), and its choices/conflicts are the counts reached before the kill. \texttt  {gc\_noheur}, \texttt  {la} and \texttt  {lc} ground programs of the same size (about $52.76$ million rules), and \texttt  {gc}, \texttt  {ga} and \texttt  {ga\_weak} programs of another common size (about $54.5$ million). Within each group the grounding column agrees to a few percent, and the solving column is what separates the variants: an order of magnitude between \texttt  {gc} and the baseline, three orders between the baseline and \texttt  {la}. The \texttt  {la\_co} run is at the resolution limit of clingo's own timer. Choices and conflicts are exact. \texttt  {la\_aux} is discussed in Section~\ref {sec:aux-form}.}}{27}{table.4.5}\protected@file@percent }
\newlabel{tab:bsp-n120}{{4.5}{27}{BSP at $n=120$, native backend, under the 600\,s / 30\,GB limits. \emph {T} marks a timeout; the parenthesized solving value for \texttt {ga} is a lower bound (total minus grounding at the moment it was killed), and its choices/conflicts are the counts reached before the kill. \texttt {gc\_noheur}, \texttt {la} and \texttt {lc} ground programs of the same size (about $52.76$ million rules), and \texttt {gc}, \texttt {ga} and \texttt {ga\_weak} programs of another common size (about $54.5$ million). Within each group the grounding column agrees to a few percent, and the solving column is what separates the variants: an order of magnitude between \texttt {gc} and the baseline, three orders between the baseline and \texttt {la}. The \texttt {la\_co} run is at the resolution limit of clingo's own timer. Choices and conflicts are exact. \texttt {la\_aux} is discussed in Section~\ref {sec:aux-form}}{table.4.5}{}}
