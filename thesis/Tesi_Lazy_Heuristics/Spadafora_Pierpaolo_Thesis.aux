\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces BSP campaign overview ($n=10..200$, 600\,s / 30\,GiB per run). At $n=180$ five of the eight variants fail with both flags set (\emph  {T} and \emph  {M} simultaneously) on both backends, the one size at which the base program's own growth exhausts the memory budget at essentially the same point at which it would time out; \texttt  {la\_aux} reaches that point one size earlier. Two Prolog cells are non-monotone (\texttt  {gc} fails at $140$ but solves $150$; \texttt  {ga\_weak} fails at $150$ but solves $160$). Above $n \approx 140$ all same-encoding variants are within the node-to-node spread of the grounding time discussed in Section~\ref  {sec:node-variance}, so the exact position of their frontiers should not be over-read: the separations that survive that spread are \texttt  {ga} and \texttt  {la\_aux} at one end and \texttt  {la\_co} at the other.}}{25}{table.0.2}\protected@file@percent }
\newlabel{tab:overview-bsp}{{2}{25}{BSP campaign overview ($n=10..200$, 600\,s / 30\,GiB per run). At $n=180$ five of the eight variants fail with both flags set (\emph {T} and \emph {M} simultaneously) on both backends, the one size at which the base program's own growth exhausts the memory budget at essentially the same point at which it would time out; \texttt {la\_aux} reaches that point one size earlier. Two Prolog cells are non-monotone (\texttt {gc} fails at $140$ but solves $150$; \texttt {ga\_weak} fails at $150$ but solves $160$). Above $n \approx 140$ all same-encoding variants are within the node-to-node spread of the grounding time discussed in Section~\ref {sec:node-variance}, so the exact position of their frontiers should not be over-read: the separations that survive that spread are \texttt {ga} and \texttt {la\_aux} at one end and \texttt {la\_co} at the other}{table.0.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces PUP campaign overview (\texttt  {double-$N$}, $N=20..200$, 600\,s / 30\,GiB per run). Under this budget neither \texttt  {ga} nor \texttt  {la} fails anywhere in the tested range; the two variants whose heuristic carries no dynamic aggregate (\texttt  {gc\_noheur}, \texttt  {gc}) stall by timeout well inside it. Two native cells are not monotone in $N$: both \texttt  {gc} and \texttt  {lc} fail on \texttt  {double-80} but solve \texttt  {double-100}. This is a property of the family --- one instance per size, with neighbouring sizes of very different hardness --- and Section~\ref  {sec:pup} reads it through the choice counts rather than the times.}}{25}{table.0.3}\protected@file@percent }
\newlabel{tab:overview-pup}{{3}{25}{PUP campaign overview (\texttt {double-$N$}, $N=20..200$, 600\,s / 30\,GiB per run). Under this budget neither \texttt {ga} nor \texttt {la} fails anywhere in the tested range; the two variants whose heuristic carries no dynamic aggregate (\texttt {gc\_noheur}, \texttt {gc}) stall by timeout well inside it. Two native cells are not monotone in $N$: both \texttt {gc} and \texttt {lc} fail on \texttt {double-80} but solve \texttt {double-100}. This is a property of the family --- one instance per size, with neighbouring sizes of very different hardness --- and Section~\ref {sec:pup} reads it through the choice counts rather than the times}{table.0.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces HRP campaign overview (\texttt  {house-$N$}, $N=2..20$ persons, 600\,s / 30\,GiB per run).}}{26}{table.0.4}\protected@file@percent }
\newlabel{tab:overview-hrp}{{4}{26}{HRP campaign overview (\texttt {house-$N$}, $N=2..20$ persons, 600\,s / 30\,GiB per run)}{table.0.4}{}}
