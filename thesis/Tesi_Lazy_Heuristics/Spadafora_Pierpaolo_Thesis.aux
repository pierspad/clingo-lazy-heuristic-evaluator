\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces BSP, native backend: total clingo time. One run per point; a curve ends where its variant stops solving within the limits. Above $n \approx 120$ the three same-encoding curves (\texttt  {gc\_noheur}, \texttt  {la}, \texttt  {lc}) cross each other repeatedly: they ground identical programs, and the crossings are the node-to-node spread of Section~\ref  {sec:node-variance}, not a difference between variants. Figure~\ref  {fig:bsp-solving} isolates the component that does separate them.}}{29}{figure.0.5}\protected@file@percent }
\newlabel{fig:bsp-total}{{5}{29}{BSP, native backend: total clingo time. One run per point; a curve ends where its variant stops solving within the limits. Above $n \approx 120$ the three same-encoding curves (\texttt {gc\_noheur}, \texttt {la}, \texttt {lc}) cross each other repeatedly: they ground identical programs, and the crossings are the node-to-node spread of Section~\ref {sec:node-variance}, not a difference between variants. Figure~\ref {fig:bsp-solving} isolates the component that does separate them}{figure.0.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces BSP, native backend: solving time only. \texttt  {la} is indistinguishable from zero at every size; \texttt  {ga} leaves the chart after $n=60$.}}{30}{figure.0.6}\protected@file@percent }
\newlabel{fig:bsp-solving}{{6}{30}{BSP, native backend: solving time only. \texttt {la} is indistinguishable from zero at every size; \texttt {ga} leaves the chart after $n=60$}{figure.0.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces BSP at $n=120$, native backend, under the 600\,s / 30\,GiB limits. \emph  {T} marks a timeout; the parenthesized solving value for \texttt  {ga} is a lower bound (total minus grounding at the moment it was killed), and its choices/conflicts are the counts reached before the kill. The three grounding times in the top block and in the \texttt  {la}/\texttt  {lc} rows refer to programs of the same size (\texttt  {gc\_noheur}, \texttt  {la} and \texttt  {lc} ground $52{,}759{,}25x$ rules; \texttt  {gc}, \texttt  {ga} and \texttt  {ga\_weak} $54{,}5xx{,}xxx$): their differences are node spread, not variant cost, and only the solving column separates same-encoding variants reliably. Choices and conflicts are exact. \texttt  {la\_aux} is discussed in Section~\ref  {sec:aux-form}.}}{30}{table.0.6}\protected@file@percent }
\newlabel{tab:bsp-n120}{{6}{30}{BSP at $n=120$, native backend, under the 600\,s / 30\,GiB limits. \emph {T} marks a timeout; the parenthesized solving value for \texttt {ga} is a lower bound (total minus grounding at the moment it was killed), and its choices/conflicts are the counts reached before the kill. The three grounding times in the top block and in the \texttt {la}/\texttt {lc} rows refer to programs of the same size (\texttt {gc\_noheur}, \texttt {la} and \texttt {lc} ground $52{,}759{,}25x$ rules; \texttt {gc}, \texttt {ga} and \texttt {ga\_weak} $54{,}5xx{,}xxx$): their differences are node spread, not variant cost, and only the solving column separates same-encoding variants reliably. Choices and conflicts are exact. \texttt {la\_aux} is discussed in Section~\ref {sec:aux-form}}{table.0.6}{}}
