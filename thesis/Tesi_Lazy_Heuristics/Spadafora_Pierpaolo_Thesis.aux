\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces PUP, native backend: total clingo time. Each curve ends at the last instance its variant solves.}}{41}{figure.0.14}\protected@file@percent }
\newlabel{fig:pup-total}{{14}{41}{PUP, native backend: total clingo time. Each curve ends at the last instance its variant solves}{figure.0.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces PUP frontier, native backend, 600\,s / 30\,GiB per run: largest \texttt  {double-$N$} solved and its cost. \texttt  {ga} and \texttt  {la} solve the whole tested range and are reported at $N=200$; the other three still fail inside the range, and are reported at the largest size they solve. Unlike the BSP table, the separations here are between programs of genuinely different size --- \texttt  {ga} grounds twice the memory of \texttt  {la} at every size --- and are therefore an order of magnitude larger than the node spread of Section~\ref  {sec:node-variance}.}}{41}{table.0.9}\protected@file@percent }
\newlabel{tab:pup-frontier}{{9}{41}{PUP frontier, native backend, 600\,s / 30\,GiB per run: largest \texttt {double-$N$} solved and its cost. \texttt {ga} and \texttt {la} solve the whole tested range and are reported at $N=200$; the other three still fail inside the range, and are reported at the largest size they solve. Unlike the BSP table, the separations here are between programs of genuinely different size --- \texttt {ga} grounds twice the memory of \texttt {la} at every size --- and are therefore an order of magnitude larger than the node spread of Section~\ref {sec:node-variance}}{table.0.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces PUP, native backend: grounding time and peak memory. \texttt  {ga} pays the heuristic unrolling (orange) on top of the base growth; \texttt  {la} (green) pays the base program only, and stays consistently cheaper at every common size.}}{42}{figure.0.15}\protected@file@percent }
\newlabel{fig:pup-ground-mem}{{15}{42}{PUP, native backend: grounding time and peak memory. \texttt {ga} pays the heuristic unrolling (orange) on top of the base growth; \texttt {la} (green) pays the base program only, and stays consistently cheaper at every common size}{figure.0.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces PUP: native-versus-Prolog solving comparison (left) and cumulative synchronization cost of the Prolog backend (right). For \texttt  {la} the synchronization, not the query, is the dominant lazy cost at scale.}}{43}{figure.0.16}\protected@file@percent }
\newlabel{fig:pup-comparison}{{16}{43}{PUP: native-versus-Prolog solving comparison (left) and cumulative synchronization cost of the Prolog backend (right). For \texttt {la} the synchronization, not the query, is the dominant lazy cost at scale}{figure.0.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.12}HRP: Semantics Without Aggregates}{44}{subsection.0.3.12}\protected@file@percent }
\newlabel{sec:hrp}{{3.12}{44}{HRP: Semantics Without Aggregates}{subsection.0.3.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces HRP: solver choices on the native backend (left) and the native-versus-Prolog solving comparison (right). The only diverging curve is \texttt  {lc}, in both plots.}}{44}{figure.0.17}\protected@file@percent }
\newlabel{fig:hrp}{{17}{44}{HRP: solver choices on the native backend (left) and the native-versus-Prolog solving comparison (right). The only diverging curve is \texttt {lc}, in both plots}{figure.0.17}{}}
