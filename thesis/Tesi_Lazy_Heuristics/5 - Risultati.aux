\@writefile{lot}{\contentsline {table}{\numberline {5.12}{\ignorespaces The \texttt  {\_co} family on BSP at $n=200$, C++ backend. RSS is marked \emph  {n/a} when the resource sampler reports zero on a very short run. All six variants solve every size from $10$ to $200$, and none spends more than about a second in search at any of them. The standard and compact encodings share their heuristic definitions; Table~\ref {tab:bsp-n120} reports both formulations at $n=120$, whereas this table uses $n=200$.}}{67}{table.5.12}\protected@file@percent }
\newlabel{tab:co-family}{{5.12}{67}{The \texttt {\_co} family on BSP at $n=200$, C++ backend. RSS is marked \emph {n/a} when the resource sampler reports zero on a very short run. All six variants solve every size from $10$ to $200$, and none spends more than about a second in search at any of them. The standard and compact encodings share their heuristic definitions; Table~\ref {tab:bsp-n120} reports both formulations at $n=120$, whereas this table uses $n=200$}{table.5.12}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {5.23}{\ignorespaces The \texttt  {\_co} family on BSP: grounding time (top) and solver choices (bottom). The ground and the lazy variants separate on grounding by three orders of magnitude.}}{68}{figure.5.23}\protected@file@percent }
\newlabel{fig:co-family}{{5.23}{68}{The \texttt {\_co} family on BSP: grounding time (top) and solver choices (bottom). The ground and the lazy variants separate on grounding by three orders of magnitude}{figure.5.23}{}}
\@writefile{toc}{\contentsline {paragraph}{On search, the answer is no.}{68}{section*.25}\protected@file@percent }
\def\@LN@column{1}
\@writefile{toc}{\contentsline {paragraph}{On representation, the answer is yes, and it is now measured cleanly.}{69}{section*.26}\protected@file@percent }
