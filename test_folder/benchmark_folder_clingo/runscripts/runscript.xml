<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runscript per la suite "Lazy Heuristics / Dynamic Aggregates".

  ASSI DELL'ESPERIMENTO
    * backend  -> due SYSTEM:   clingo-native (C++), clingo-prolog (SWI in-process)
    * variante -> SETTING:      g* = ground-and-solve, l* = lazy/dynamic-aggregates
                                (la prima lettera) ; *c = clingo-like, *a = alpha-like
    * famiglia -> BENCHMARK:    BSP (parametrico n), PUP (double-*.asp), HRP (house-*.asp)

  PIU' UN TERZO SYSTEM FUORI MATRICE
    * alpha-qh -> il solver lazy-grounding Alpha (variante -uqh) come
      RIFERIMENTO ESTERNO, non come terzo backend: due setting soltanto
      (encoding dei paper + suo baseline senza euristiche), solo su bsp/pup.
      V. il commento esteso sopra il suo <system>.

  COME SI COMBINANO
    Ogni SETTING porta uno o piu' <encoding> taggati per famiglia
    (encoding_tag = bsp|pup|hrp). Ogni <folder> di benchmark ha lo stesso
    encoding_tag: cosi' la variante "gc" usa l'encoding BSP_gc.lp sui BSP,
    PUP_gc.lp sui PUP, ecc. L'attributo `tag` del setting indica invece a
    quali famiglie la variante si applica (le varianti BSP-only ga_weak/
    la_aux/la_co hanno tag="bsp" e non vengono eseguite su PUP/HRP).
    I runtag selezionano i setting per famiglia via `tag`.

  ESECUZIONE
    Entrambi i system vengono eseguiti automaticamente da ogni runtag
    (il runtag non fissa il system): clingo-native usa encodings-native/,
    clingo-prolog usa encodings-prolog/.

  Riga di comando finale (vedi templates/seq-generic.sh):
    programs/SYSTEM  [opzioni clingo]  ISTANZA  ENCODING...
  con runlim a imporre il timeout (real-time-limit) e la memoria (space-limit).
-->
<runscript output="output">

  <!-- ===================== MACCHINE ===================== -->
  <machine name="local" cpu="local-dev" memory="local"/>
  <machine name="hpc"   cpu="cluster"   memory="cluster"/>

  <!-- ===================== TEMPLATE DI RUN ===================== -->
  <config name="seq-generic" template="templates/seq-generic.sh"/>

  <!-- ===================== SYSTEM: BACKEND NATIVE ===================== -->
  <system name="clingo-native" version="1.0" measures="clasp" config="seq-generic"
          cmdline="--stats=2 --heuristic=Domain -n 1">

    <setting name="gc_noheur" tag="bsp pup hrp">
      <encoding file="../encodings-native/1_BSP/BSP_gc_noheur.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-native/2_PUP/PUP_gc_noheur.lp" encoding_tag="pup"/>
      <encoding file="../encodings-native/3_HRP/HRP_gc_noheur.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="gc" tag="bsp pup hrp">
      <encoding file="../encodings-native/1_BSP/BSP_gc.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-native/2_PUP/PUP_gc.lp" encoding_tag="pup"/>
      <encoding file="../encodings-native/3_HRP/HRP_gc.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="ga" tag="bsp pup hrp">
      <encoding file="../encodings-native/1_BSP/BSP_ga.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-native/2_PUP/PUP_ga.lp" encoding_tag="pup"/>
      <encoding file="../encodings-native/3_HRP/HRP_ga.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="la" tag="bsp pup hrp">
      <encoding file="../encodings-native/1_BSP/BSP_la.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-native/2_PUP/PUP_la.lp" encoding_tag="pup"/>
      <encoding file="../encodings-native/3_HRP/HRP_la.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="lc" tag="bsp pup hrp">
      <encoding file="../encodings-native/1_BSP/BSP_lc.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-native/2_PUP/PUP_lc.lp" encoding_tag="pup"/>
      <encoding file="../encodings-native/3_HRP/HRP_lc.lp" encoding_tag="hrp"/>
    </setting>
    <!-- varianti SOLO BSP -->
    <setting name="ga_weak" tag="bsp">
      <encoding file="../encodings-native/1_BSP/BSP_ga_weak.lp" encoding_tag="bsp"/>
    </setting>
    <setting name="la_aux" tag="bsp">
      <encoding file="../encodings-native/1_BSP/BSP_la_aux.lp" encoding_tag="bsp"/>
    </setting>
    <setting name="la_co" tag="bsp">
      <encoding file="../encodings-native/1_BSP/BSP_la_co.lp" encoding_tag="bsp"/>
    </setting>
  </system>

  <!-- ===================== SYSTEM: BACKEND PROLOG ===================== -->
  <system name="clingo-prolog" version="1.0" measures="clasp" config="seq-generic"
          cmdline="--stats=2 --heuristic=Domain -n 1">

    <setting name="gc_noheur" tag="bsp pup hrp">
      <encoding file="../encodings-prolog/1_BSP/BSP_gc_noheur.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-prolog/2_PUP/PUP_gc_noheur.lp" encoding_tag="pup"/>
      <encoding file="../encodings-prolog/3_HRP/HRP_gc_noheur.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="gc" tag="bsp pup hrp">
      <encoding file="../encodings-prolog/1_BSP/BSP_gc.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-prolog/2_PUP/PUP_gc.lp" encoding_tag="pup"/>
      <encoding file="../encodings-prolog/3_HRP/HRP_gc.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="ga" tag="bsp pup hrp">
      <encoding file="../encodings-prolog/1_BSP/BSP_ga.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-prolog/2_PUP/PUP_ga.lp" encoding_tag="pup"/>
      <encoding file="../encodings-prolog/3_HRP/HRP_ga.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="la" tag="bsp pup hrp">
      <encoding file="../encodings-prolog/1_BSP/BSP_la.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-prolog/2_PUP/PUP_la.lp" encoding_tag="pup"/>
      <encoding file="../encodings-prolog/3_HRP/HRP_la.lp" encoding_tag="hrp"/>
    </setting>
    <setting name="lc" tag="bsp pup hrp">
      <encoding file="../encodings-prolog/1_BSP/BSP_lc.lp" encoding_tag="bsp"/>
      <encoding file="../encodings-prolog/2_PUP/PUP_lc.lp" encoding_tag="pup"/>
      <encoding file="../encodings-prolog/3_HRP/HRP_lc.lp" encoding_tag="hrp"/>
    </setting>
    <!-- varianti SOLO BSP -->
    <setting name="ga_weak" tag="bsp">
      <encoding file="../encodings-prolog/1_BSP/BSP_ga_weak.lp" encoding_tag="bsp"/>
    </setting>
    <setting name="la_aux" tag="bsp">
      <encoding file="../encodings-prolog/1_BSP/BSP_la_aux.lp" encoding_tag="bsp"/>
    </setting>
    <setting name="la_co" tag="bsp">
      <encoding file="../encodings-prolog/1_BSP/BSP_la_co.lp" encoding_tag="bsp"/>
    </setting>
  </system>

  <!-- ===================== SYSTEM: ALPHA (Qh) =====================
       Terzo system, ma di natura diversa dagli altri due: non e' un terzo
       BACKEND del meccanismo di questa tesi, e' il SISTEMA DI RIFERIMENTO
       esterno. Alpha e' il solver lazy-grounding dei paper Comploi-Taupe, e
       la sua variante "Qh" (-uqh, euristiche valutate come query Prolog) e'
       l'unica implementazione esistente degli aggregati dinamici nelle
       euristiche: cioe' esattamente la semantica che gli encoding la/lc
       riproducono dentro clingo. Serve a rispondere a "quanto costa ottenere
       quella semantica restando in ground-and-solve, rispetto a prenderla da
       chi la implementa nativamente".

       NIENTE MATRICE QUI. Gli assi approccio x semantica descrivono le
       varianti di UN encoding dentro clingo; Alpha non ha varianti, ha un
       encoding solo. I due setting sono l'encoding dei paper e il suo
       baseline interno (-ids, euristiche ignorate), che sta ad `alpha` come
       `gc_noheur` sta a `gc`.

       ENCODING: presi TALI E QUALI dal supplementary material dei paper
       (v. le intestazioni in ../encodings-alpha/). Non sono traduzioni
       fatte qui - e' questo che rende il confronto difendibile.

       FAMIGLIE: solo bsp e pup. Per HRP non esiste un encoding Alpha degli
       autori: usarne uno tradotto a mano introdurrebbe una variabile in
       piu' proprio nel confronto fra sistemi.

       Riga di comando (v. programs/alpha-qh-1.0): Alpha vuole "-i file",
       non argomenti posizionali, e le istanze BSP vanno tradotte da
       "#const n=N." a "max_Value(N)."; se ne occupa il wrapper.
       I -f replicano i #show degli encoding clingo, cosi' che nessuno dei
       due sistemi paghi la stampa dei predicati ausiliari: i filtri per
       predicati assenti in un dato encoding sono innocui.
  -->
  <system name="alpha-qh" version="1.0" measures="alpha" config="seq-generic"
          cmdline="-st -n 1 -f sum_B -f sum_C -f b -f c -f assigned_zone_unit -f assigned_sensor_unit">

    <setting name="alpha" tag="bsp pup" cmdline="-uqh">
      <encoding file="../encodings-alpha/1_BSP/BSP_alpha.asp" encoding_tag="bsp"/>
      <encoding file="../encodings-alpha/2_PUP/PUP_alpha.asp" encoding_tag="pup"/>
    </setting>
    <setting name="alpha_noheur" tag="bsp pup" cmdline="-ids">
      <encoding file="../encodings-alpha/1_BSP/BSP_alpha.asp" encoding_tag="bsp"/>
      <encoding file="../encodings-alpha/2_PUP/PUP_alpha.asp" encoding_tag="pup"/>
    </setting>
  </system>

  <!-- ===================== JOB ===================== -->
  <!-- timeout/memout in secondi / MB. parallel=1 per misure di tempo pulite. -->
  <seqjob  name="seq-local" timeout="300s" runs="1" memout="30000" parallel="1"/>
  <!-- walltime ridotta da 23h59m59s a 2h (2026-07-10): con script_mode="timeout"
       btool impacchetta i run in sequenza finche' non riempie la walltime, poi
       ne apre uno nuovo (vedi commento sotto il <project>). Walltime piu' corta
       = piu' *.dist per project = piu' allocazioni SLURM esclusive concorrenti,
       usando meglio i nodi liberi di kr/kr-big invece di tenerne 3 impegnati
       per ~24h a testa. memout invariato: e' un limite di runlim via software,
       non della RAM fisica del nodo, quindi aggiungere kr-big (più RAM) non
       altera il risultato "ground muore di memout su PUP grande" - gli da solo
       margine contro un OOM-killer di sistema prima del memout pulito.
       partition="kr,kr-big": kr-slv escluso, nessuna association per l'utente
       (vedi sacctmgr show associations) - fallirebbe in sottomissione. -->
  <distjob name="dist-hpc"  timeout="600s" runs="1" memout="30000"
           script_mode="timeout" walltime="2h" cpt="4" partition="kr,kr-big"/>

  <!-- ===================== BENCHMARK (una famiglia per benchmark) ===================== -->
  <benchmark name="BSP">
    <folder path="benchmarks/BSP" encoding_tag="bsp"/>
  </benchmark>
  <benchmark name="PUP">
    <folder path="benchmarks/PUP" encoding_tag="pup"/>
  </benchmark>
  <benchmark name="HRP">
    <folder path="benchmarks/HRP" encoding_tag="hrp"/>
  </benchmark>

  <!-- ===================== PROGETTI ===================== -->
  <!-- Studio LOCALE (sequenziale). -->
  <project name="study-local" job="seq-local">
    <runtag machine="local" benchmark="BSP" tag="bsp"/>
    <runtag machine="local" benchmark="PUP" tag="pup"/>
    <runtag machine="local" benchmark="HRP" tag="hrp"/>
  </project>

  <!-- Studio su CLUSTER (SLURM, distribuito).
       Split in 3 project (uno per famiglia) invece di un unico project
       "study-hpc" monolitico: prima "btool gen" produceva un solo *.dist
       che eseguiva BSP+PUP+HRP in sequenza dentro UNA sola allocazione
       SLURM (visto nello smoke test: "Found 1 jobs to dispatch").
       Dentro ciascun project, con walltime="2h" (vedi <distjob> sopra)
       "btool gen" produce PIU' *.dist per project, non piu' uno solo:
       BSP (320 run: 20 istanze [10..200 step 10, esteso 2026-07-22] x 8
       setting x 2 backend) -> ~27 *.dist stimati, PUP e HRP (100 run
       ciascuno: 10 istanze x 5 setting x 2 backend) -> ~9 *.dist ciascuno,
       per un totale di ~45 job SLURM invece di 3-4 (stima approssimata:
       "run per *.dist" dipende dal tempo reale di ciascun run, che ora va
       fino a 600s/run col timeout alzato, non solo dal conteggio). Restano
       comunque ben sotto il MaxSubmit=100 per utente su kr/kr-big (sacctmgr,
       verificato 2026-07-10).
       "btool run-dist" (default -j 100) li sottomette tutti; SLURM li
       accoda e li fa partire via via che i nodi di kr (10) e kr-big (2) si
       liberano, invece di tenerne solo 3 impegnati per l'intera durata.
       I 3/4_run_benchmark_*.sh ciclano comunque sui 3 nomi di project (uno
       per famiglia): e' "btool run-dist" che, per ciascun project,
       dispaccia tutti i suoi *.dist.
       "parallel=1" nel <seqjob>/<distjob> resta invariato: il
       parallelismo e' TRA i job (nodi/allocazioni diverse), non dentro lo
       stesso job (che resta sequenziale), cosi' le misure di tempo restano
       pulite. -->
  <project name="study-hpc-bsp" job="dist-hpc">
    <runtag machine="hpc" benchmark="BSP" tag="bsp"/>
  </project>
  <project name="study-hpc-pup" job="dist-hpc">
    <runtag machine="hpc" benchmark="PUP" tag="pup"/>
  </project>
  <project name="study-hpc-hrp" job="dist-hpc">
    <runtag machine="hpc" benchmark="HRP" tag="hrp"/>
  </project>

</runscript>
