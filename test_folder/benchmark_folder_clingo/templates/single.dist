#!/bin/bash
#SBATCH --output=out.%j
#SBATCH --error=err.%j
#SBATCH --time={walltime}        # walltime
#SBATCH --cpus-per-task={cpt}    # number of processor cores (i.e. tasks)
#SBATCH --partition={partition}
#SBATCH --exclusive              # nodo intero riservato: nessun altro job condivide la RAM durante la misura
{dist_options}                  # additional dist options (specified via runscript setting)

# NIENTE `set -e` qui: ogni $i e' un run indipendente (istanza x setting x
# sistema) il cui exit code riflette l'esito del solver (SAT/UNSAT/timeout),
# non un errore di sistema — seq-generic.sh stesso e' scritto apposta per non
# propagare mai un fallimento (fa sempre `touch .finished` come ultima
# istruzione). Con `set -e` qui, il PRIMO run che ritorna non-zero abortiva
# l'intero job SLURM, abbandonando in silenzio tutti i run successivi nella
# lista (visto in pratica: BSP completo, PUP/HRP azzerati perche' dichiarati
# dopo in runscript.xml). Continuiamo sempre, loggando i fallimenti in
# err.%j invece di sparire senza traccia.

# Load environment modules for your application here.
source ~/.bashrc

# Run jobs
jobs="{jobs}"
echo running jobs@$(hostname)...
echo ""
echo "jobs:" $jobs
echo ""
for i in $jobs
do
    echo "running " $i
    # Traccia del nodo, run per run. I job sono pinnati su un insieme
    # omogeneo (scripts/hpc_target.sh, --exclude iniettato da
    # pin_dist_scripts), ma il pinning e' una promessa: questo file e' la
    # prova. report_nodes_used() li aggrega in nodes_used.txt, ed e' quello
    # che permette di scrivere in tesi "la campagna ha girato su N nodi
    # identici" invece di doverlo assumere.
    # Solo se il run non e' gia' completato: seq-generic.sh salta i run con
    # .finished, e riscrivere .node li attribuirebbe al nodo sbagliato.
    d="$(dirname $i)"
    [ -e "$d/.finished" ] || hostname > "$d/.node" 2>/dev/null
    if ! $i; then
        echo "!! job fallito (exit $?): $i" >&2
    fi
done
