#!/usr/bin/env bash
# ============================================================
# Wrapper "system" per benchmark-tool: solver ALPHA (Qh).
#
# Alpha e' il sistema lazy-grounding di riferimento. Questa e' la variante
# "Qh" (flag -uqh), in cui le euristiche domain-specific sono valutate
# come query Prolog: e' l'UNICA implementazione esistente degli aggregati
# dinamici nelle euristiche, cioe' della semantica che gli encoding la/lc
# di questa suite riproducono dentro clingo. Il branch upstream
# domspec_heuristics_extended accetta la stessa sintassi ma valuta
# l'aggregato staticamente: verificato, su BSP l'euristica non bilancia
# nulla e i backtrack esplodono. Quindi qui serve per forza il build con
# JPL, prodotto da compile_all.sh.
#
# DUE COSE che questo wrapper deve fare e che gli altri wrapper non fanno:
#
#  1) Alpha vuole gli input come "-i file", non come argomenti posizionali,
#     mentre templates/seq-generic.sh accoda istanza ed encoding in fondo
#     alla riga di comando (e' il formato di clingo). Qui li separiamo:
#     tutto cio' che e' un file leggibile diventa un -i, il resto passa
#     invariato come opzione.
#
#  2) Le istanze BSP della suite sono "#const n=N." (sintassi clingo).
#     Alpha non ha i program constant e l'encoding dei paper prende la
#     taglia da max_Value/1. Traduciamo al volo. E' l'alternativa a tenere
#     due cartelle di istanze BSP parallele, che prima o poi divergono:
#     cosi' Alpha e clingo leggono per costruzione la stessa taglia.
#     Le istanze PUP non hanno bisogno di nulla, sono gia' byte-identiche
#     a quelle del supplementary material dei paper (verificato).
#
# Env:
#   ALPHA_JAR       jar bundled di Alpha (default: build del repo)
#   SWIPL_MODERN_PREFIX  prefix di SWI-Prolog con JPL (default: $HOME/swipl-10)
#   ALPHA_XMX       heap massimo della JVM (default 28g)
#                   DEVE restare sotto il memout di runlim, altrimenti si
#                   misura un OOM-kill del processo invece del memout
#                   pulito che il resultparser sa riconoscere.
# ============================================================
set -euo pipefail

# Glob invece del nome fisso: gradle battezza il jar in base al NOME DELLA
# CARTELLA del progetto (ALPHA-bundled.jar qui, alpha-bundled.jar altrove),
# e scripts/bench_common.sh lo cerca gia' cosi'. Tenere due convenzioni
# diverse significa che il wrapper puo' fallire su un jar che la pipeline
# considera presente.
: "${ALPHA_DIR:=$HOME/clingo-lazy-heuristics/ALPHA}"
: "${ALPHA_JAR:=$(ls -1 "$ALPHA_DIR"/build/libs/*-bundled.jar 2>/dev/null | head -1)}"
: "${SWIPL_MODERN_PREFIX:=$HOME/swipl-10}"
: "${ALPHA_XMX:=28g}"

if [ -z "$ALPHA_JAR" ] || [ ! -f "$ALPHA_JAR" ]; then
    echo "*** alpha ERROR: nessun *-bundled.jar in $ALPHA_DIR/build/libs" >&2
    if [ -d "$ALPHA_DIR/build/libs" ]; then
        echo "    la cartella esiste ma contiene: $(ls -1 "$ALPHA_DIR/build/libs" 2>/dev/null | tr '\n' ' ')" >&2
        echo "    -> il passo [6/6] di compile_all.sh e' fallito a meta'." >&2
    else
        echo "    la cartella build/libs non esiste: il passo [6/6] di compile_all.sh non e' mai arrivato in fondo." >&2
        echo "    Guarda il log della build:  grep -nE '==>|XX |FAILED|error' ~/clingo-lazy-heuristics/compile_*.log | tail -30" >&2
    fi
    exit 1
fi

# --- scelta della JVM ---------------------------------------------------
# NON basta invocare `java` ereditando il PATH. jpl.jar viene costruito
# dentro SWI-Prolog dal JDK che compile_all.sh ha trovato (tipicamente
# $HOME/jdk-21, scaricato da get_jdk.sh), e javac senza -target produce
# class file della PROPRIA versione. Se a runtime gira un java piu' vecchio
# — sul login node del cluster il `java` di sistema e' l'11 — si ottiene:
#
#   UnsupportedClassVersionError: org/jpl7/PrologException has been compiled
#   by a more recent version of the Java Runtime (class file version 65.0),
#   this version of the Java Runtime only recognizes ... up to 55.0
#
# (65 = Java 21, 55 = Java 11). Succederebbe identico sui compute node, cioe'
# su OGNI run della campagna, non solo nelle prove a mano. Quindi qui la JVM
# si risolve con lo stesso ordine di precedenza con cui compile_all.sh
# risolve javac, per costruzione: stesso JDK a build e a runtime.
: "${ALPHA_JAVA:=}"
if [ -z "$ALPHA_JAVA" ]; then
    if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
        ALPHA_JAVA="$JAVA_HOME/bin/java"
    else
        for _jdk in "$HOME"/jdk-* "$HOME"/jdk; do
            if [ -x "$_jdk/bin/java" ]; then ALPHA_JAVA="$_jdk/bin/java"; break; fi
        done
        unset _jdk
    fi
fi
[ -n "$ALPHA_JAVA" ] || ALPHA_JAVA="$(command -v java || true)"
if [ -z "$ALPHA_JAVA" ]; then
    echo "*** alpha ERROR: nessuna JVM trovata (ne' JAVA_HOME, ne' \$HOME/jdk-*, ne' java in PATH)" >&2
    echo "    Scaricane una con:  sh ~/clingo-lazy-heuristics/get_jdk.sh" >&2
    exit 1
fi

# Guard sulla versione: meglio un messaggio che nomina il problema che uno
# stack trace di UnsupportedClassVersionError dentro un log di benchmark.
_javaver=$("$ALPHA_JAVA" -version 2>&1 | sed -nE 's/^[a-zA-Z ]*version "([0-9]+).*/\1/p' | head -1)
if [ -n "$_javaver" ] && [ "$_javaver" -lt 17 ] 2>/dev/null; then
    echo "*** alpha ERROR: JVM troppo vecchia: $ALPHA_JAVA (Java $_javaver)" >&2
    echo "    jpl.jar e' compilato dal JDK usato da compile_all.sh (>= 17): serve la stessa JVM." >&2
    echo "    Scarica il JDK con 'sh get_jdk.sh' oppure esporta ALPHA_JAVA=/percorso/jdk/bin/java" >&2
    exit 1
fi
unset _javaver

# libjpl.so + libswipl.so vivono nel prefix non standard costruito da
# compile_all.sh. Senza questi export la JVM carica il jar ma fallisce ad
# aprire la libreria nativa, e il messaggio (UnsatisfiedLinkError) non
# assomiglia per niente a "manca SWI-Prolog".
_arch_dir="$SWIPL_MODERN_PREFIX/lib/swipl/lib/$(uname -m)-linux"
export SWI_HOME_DIR="$SWIPL_MODERN_PREFIX/lib/swipl"
export LD_LIBRARY_PATH="${_arch_dir}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export LC_ALL=C
export LC_NUMERIC=C

# --- separazione opzioni / file ------------------------------------------
opts=()
inputs=()
for arg in "$@"; do
    if [ -f "$arg" ] && [ -r "$arg" ]; then
        inputs+=("$arg")
    else
        opts+=("$arg")
    fi
done

# --- traduzione delle istanze BSP ----------------------------------------
# Un file che contiene SOLO "#const n=N." e' un'istanza BSP della suite.
# Il test e' volutamente stretto (una sola direttiva, nient'altro di
# significativo): se un domani le istanze BSP diventassero programmi veri,
# meglio non tradurle per sbaglio ma vedere Alpha lamentarsi del "#const".
tmpdir=""
cleanup() { [ -n "$tmpdir" ] && rm -rf "$tmpdir"; }
trap cleanup EXIT

translated=()
for f in "${inputs[@]}"; do
    n=$(sed -nE 's/^[[:space:]]*#const[[:space:]]+n[[:space:]]*=[[:space:]]*([0-9]+)[[:space:]]*\..*$/\1/p' "$f" | head -1)
    # NB: il "|| true" non e' cosmetico. grep -v esce 1 quando NON resta
    # alcuna riga, che e' esattamente il caso di un'istanza BSP ben formata;
    # con set -e + pipefail lo script morirebbe in silenzio proprio sul
    # caso buono (visto in pratica: exit 1 e zero output).
    other=$( { grep -vE '^[[:space:]]*(%|#const[[:space:]]+n[[:space:]]*=|$)' "$f" || true; } | wc -l)
    if [ -n "$n" ] && [ "$other" -eq 0 ]; then
        [ -n "$tmpdir" ] || tmpdir=$(mktemp -d)
        printf 'max_Value(%s).\n' "$n" > "$tmpdir/$(basename "$f").asp"
        translated+=("$tmpdir/$(basename "$f").asp")
    else
        translated+=("$f")
    fi
done

# --- riga di comando finale ----------------------------------------------
cmd=("$ALPHA_JAVA" "-Xmx${ALPHA_XMX}" "-Djava.library.path=${_arch_dir}" -jar "$ALPHA_JAR")
cmd+=("${opts[@]}")
for f in "${translated[@]}"; do cmd+=(-i "$f"); done

exec "${cmd[@]}"
